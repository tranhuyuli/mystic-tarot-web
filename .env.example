# ==============================================================================
# MYSTIC TAROT WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env và điền các giá trị phù hợp
# Command: cp .env.example .env
# ==============================================================================

# Cổng khởi chạy máy chủ (Production server & Docker)
PORT=3000

# ==============================================================================
# CẤU HÌNH NHÀ CUNG CẤP AI / LLM (Tương thích chuẩn OpenAI API)
# Chọn 1 trong các phương án dưới đây và điền thông tin:
# ==============================================================================

# --- PHƯƠNG ÁN 1: OpenAI (Mặc định) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# --- PHƯƠNG ÁN 2: DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.7

# --- PHƯƠNG ÁN 3: OpenRouter (Claude, Llama, Gemini...) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_TEMPERATURE=0.7

# --- PHƯƠNG ÁN 4: Ollama (Chạy offline cục bộ, hoàn toàn miễn phí) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:latest
# LLM_TEMPERATURE=0.7
